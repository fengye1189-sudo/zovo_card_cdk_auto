SERVER_HOST=127.0.0.1
SERVER_PORT=9080
SERVER_MODE=release
DB_PATH=/opt/cdk-recharge/data/cdk_recharge.db
WEB_DIR=/opt/cdk-recharge/web
# 必须替换为至少 32 个字符的随机值；生产缺失或过短时服务会拒绝启动。
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_EXPIRATION_HOURS=24
INSTALL_MODE=wizard
# 可选：固定安装令牌；不设则启动日志打印随机 token
# SETUP_BOOTSTRAP_TOKEN=
# 公网域名安装：留空（仅靠 Setup Token）。仅本机装时可写 127.0.0.1,::1
SETUP_ALLOW_CIDRS=
TRUSTED_PROXIES=127.0.0.1

# 托管激活渠道：客户仍只访问本站；API Key 仅由后端读取。
JZ_ACTIVATION_ENABLED=true
JZ_ACTIVATION_API_BASE=https://apiai.jzplus.org
# 服务方分配专属密钥后填写；禁止写入前端或公开仓库。
# JZ_ACTIVATION_API_KEY=

# 一键热更新（管理后台）。默认开启；设 0 关闭。
# 下载 GitHub Release 的 cdk-bundle-linux-amd64.tgz，热替换二进制+web 后 re-exec（不碰 app.env/data）
UPDATE_ENABLED=1
# CDK_GITHUB_REPO=zovocard/zovo_card_cdk_auto
# 私有仓或提高 API 限额时可选
# GITHUB_TOKEN=
# 安装根目录（默认取可执行文件所在目录，生产一般为 /opt/cdk-recharge）
# CDK_INSTALL_DIR=/opt/cdk-recharge
